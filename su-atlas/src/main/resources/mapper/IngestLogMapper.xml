<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.su.atlas.mapper.IngestLogMapper">

  <resultMap id="BaseResultMap" type="com.su.atlas.entity.IngestLog">
    <id column="log_id" property="logId"/>
    <result column="job_id" property="jobId"/>
    <result column="start_time" property="startTime"/>
    <result column="end_time" property="endTime"/>
    <result column="status" property="status"/>
    <result column="records_in" property="recordsIn"/>
    <result column="records_out" property="recordsOut"/>
    <result column="error_msg" property="errorMsg"/>
    <result column="checkpoint" property="checkpoint"/>
  </resultMap>

  <sql id="Base_Column_List">log_id, job_id, start_time, end_time, status, records_in, records_out, error_msg, checkpoint</sql>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM ingest_log
  </select>

  <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM ingest_log WHERE log_id = #{id}
  </select>

  <delete id="deleteById" parameterType="java.lang.Long">
    DELETE FROM ingest_log WHERE log_id = #{id}
  </delete>

  <update id="updateById" parameterType="com.su.atlas.entity.IngestLog">
    UPDATE ingest_log
    SET
      job_id = #{jobId},
      start_time = #{startTime},
      end_time = #{endTime},
      status = #{status},
      records_in = #{recordsIn},
      records_out = #{recordsOut},
      error_msg = #{errorMsg},
      checkpoint = #{checkpoint}
    WHERE log_id = #{logId}
  </update>

  <insert id="insert" parameterType="com.su.atlas.entity.IngestLog">
    INSERT INTO ingest_log (
      log_id,
      job_id,
      start_time,
      end_time,
      status,
      records_in,
      records_out,
      error_msg,
      checkpoint
    ) VALUES (
      #{logId},
      #{jobId},
      #{startTime},
      #{endTime},
      #{status},
      #{recordsIn},
      #{recordsOut},
      #{errorMsg},
      #{checkpoint}
    )
  </insert>

</mapper>
