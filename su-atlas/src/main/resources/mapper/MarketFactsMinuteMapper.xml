<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.su.atlas.mapper.MarketFactsMinuteMapper">

  <resultMap id="BaseResultMap" type="com.su.atlas.entity.MarketFactsMinute">
    <id column="security_id" property="securityId"/>
    <result column="ts" property="ts"/>
    <result column="open" property="open"/>
    <result column="high" property="high"/>
    <result column="low" property="low"/>
    <result column="close" property="close"/>
    <result column="volume" property="volume"/>
    <result column="amount" property="amount"/>
    <result column="average_price" property="averagePrice"/>
    <result column="source" property="source"/>
    <result column="ingested_time" property="ingestedTime"/>
  </resultMap>

  <sql id="Base_Column_List">security_id, ts, open, high, low, close, volume, amount, average_price, source, ingested_time</sql>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM market_facts_minute
  </select>

  <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM market_facts_minute WHERE security_id = #{id}
  </select>

  <delete id="deleteById" parameterType="java.lang.Long">
    DELETE FROM market_facts_minute WHERE security_id = #{id}
  </delete>

  <update id="updateById" parameterType="com.su.atlas.entity.MarketFactsMinute">
    UPDATE market_facts_minute
    SET
      ts = #{ts},
      open = #{open},
      high = #{high},
      low = #{low},
      close = #{close},
      volume = #{volume},
      amount = #{amount},
      average_price = #{averagePrice},
      source = #{source},
      ingested_time = #{ingestedTime}
    WHERE security_id = #{securityId}
  </update>

  <insert id="insert" parameterType="com.su.atlas.entity.MarketFactsMinute">
    INSERT INTO market_facts_minute (
      security_id,
      ts,
      open,
      high,
      low,
      close,
      volume,
      amount,
      average_price,
      source,
      ingested_time
    ) VALUES (
      #{securityId},
      #{ts},
      #{open},
      #{high},
      #{low},
      #{close},
      #{volume},
      #{amount},
      #{averagePrice},
      #{source},
      #{ingestedTime}
    )
  </insert>

</mapper>
