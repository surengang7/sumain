<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.su.atlas.mapper.DataSourceMapper">

  <resultMap id="BaseResultMap" type="com.su.atlas.entity.DataSource">
    <id column="source_id" property="sourceId"/>
    <result column="name" property="name"/>
    <result column="source_type" property="sourceType"/>
    <result column="auth_type" property="authType"/>
    <result column="rate_limit" property="rateLimit"/>
    <result column="notes" property="notes"/>
    <result column="created_time" property="createdTime"/>
  </resultMap>

  <sql id="Base_Column_List">source_id, name, source_type, auth_type, rate_limit, notes, created_time</sql>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM data_source
  </select>

  <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM data_source WHERE source_id = #{id}
  </select>

  <delete id="deleteById" parameterType="java.lang.Long">
    DELETE FROM data_source WHERE source_id = #{id}
  </delete>

  <update id="updateById" parameterType="com.su.atlas.entity.DataSource">
    UPDATE data_source
    SET
      name = #{name},
      source_type = #{sourceType},
      auth_type = #{authType},
      rate_limit = #{rateLimit},
      notes = #{notes},
      created_time = #{createdTime}
    WHERE source_id = #{sourceId}
  </update>

  <insert id="insert" parameterType="com.su.atlas.entity.DataSource">
    INSERT INTO data_source (
      source_id,
      name,
      source_type,
      auth_type,
      rate_limit,
      notes,
      created_time
    ) VALUES (
      #{sourceId},
      #{name},
      #{sourceType},
      #{authType},
      #{rateLimit},
      #{notes},
      #{createdTime}
    )
  </insert>

</mapper>
