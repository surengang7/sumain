<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.su.atlas.mapper.OrdersMapper">

  <resultMap id="BaseResultMap" type="com.su.atlas.entity.Orders">
    <id column="order_id" property="orderId"/>
    <result column="account_id" property="accountId"/>
    <result column="run_id" property="runId"/>
    <result column="security_id" property="securityId"/>
    <result column="ts" property="ts"/>
    <result column="side" property="side"/>
    <result column="order_type" property="orderType"/>
    <result column="price" property="price"/>
    <result column="qty" property="qty"/>
    <result column="status" property="status"/>
    <result column="source" property="source"/>
    <result column="reason" property="reason"/>
    <result column="extra" property="extra"/>
  </resultMap>

  <sql id="Base_Column_List">order_id, account_id, run_id, security_id, ts, side, order_type, price, qty, status, source, reason, extra</sql>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM orders
  </select>

  <select id="selectById" parameterType="java.util.UUID" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM orders WHERE order_id = #{id}
  </select>

  <delete id="deleteById" parameterType="java.util.UUID">
    DELETE FROM orders WHERE order_id = #{id}
  </delete>

  <update id="updateById" parameterType="com.su.atlas.entity.Orders">
    UPDATE orders
    SET
      account_id = #{accountId},
      run_id = #{runId},
      security_id = #{securityId},
      ts = #{ts},
      side = #{side},
      order_type = #{orderType},
      price = #{price},
      qty = #{qty},
      status = #{status},
      source = #{source},
      reason = #{reason},
      extra = #{extra}
    WHERE order_id = #{orderId}
  </update>

  <insert id="insert" parameterType="com.su.atlas.entity.Orders">
    INSERT INTO orders (
      order_id,
      account_id,
      run_id,
      security_id,
      ts,
      side,
      order_type,
      price,
      qty,
      status,
      source,
      reason,
      extra
    ) VALUES (
      #{orderId},
      #{accountId},
      #{runId},
      #{securityId},
      #{ts},
      #{side},
      #{orderType},
      #{price},
      #{qty},
      #{status},
      #{source},
      #{reason},
      #{extra}
    )
  </insert>

</mapper>
