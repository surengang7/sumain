<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.su.atlas.mapper.RawPayloadMapper">

  <resultMap id="BaseResultMap" type="com.su.atlas.entity.RawPayload">
    <id column="payload_id" property="payloadId"/>
    <result column="source_id" property="sourceId"/>
    <result column="entity_type" property="entityType"/>
    <result column="entity_key" property="entityKey"/>
    <result column="fetch_time" property="fetchTime"/>
    <result column="payload" property="payload"/>
  </resultMap>

  <sql id="Base_Column_List">payload_id, source_id, entity_type, entity_key, fetch_time, payload</sql>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM raw_payload
  </select>

  <select id="selectById" parameterType="java.util.UUID" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM raw_payload WHERE payload_id = #{id}
  </select>

  <delete id="deleteById" parameterType="java.util.UUID">
    DELETE FROM raw_payload WHERE payload_id = #{id}
  </delete>

  <update id="updateById" parameterType="com.su.atlas.entity.RawPayload">
    UPDATE raw_payload
    SET
      source_id = #{sourceId},
      entity_type = #{entityType},
      entity_key = #{entityKey},
      fetch_time = #{fetchTime},
      payload = #{payload}
    WHERE payload_id = #{payloadId}
  </update>

  <insert id="insert" parameterType="com.su.atlas.entity.RawPayload">
    INSERT INTO raw_payload (
      payload_id,
      source_id,
      entity_type,
      entity_key,
      fetch_time,
      payload
    ) VALUES (
      #{payloadId},
      #{sourceId},
      #{entityType},
      #{entityKey},
      #{fetchTime},
      #{payload}
    )
  </insert>

</mapper>
